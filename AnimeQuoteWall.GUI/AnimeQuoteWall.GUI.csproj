<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AnimeQuoteWall.Core\AnimeQuoteWall.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MahApps.Metro.IconPacks" Version="5.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.10" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Resources\appicon.ico</ApplicationIcon>
    <AssemblyName>AnimeQuoteWall</AssemblyName>
    <Product>Anime Quote Wallpaper Manager</Product>
    <Company>AnimeQuoteWall</Company>
    <Description>A beautiful anime quote wallpaper generator and manager</Description>
    <Version>2.0.0</Version>
    <!-- Custom Main in App.xaml.cs runs VelopackApp before the WPF app starts. -->
    <StartupObject>AnimeQuoteWall.GUI.App</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\appicon.ico" />
    <Resource Include="Resources\appicon.png" />
    <Resource Include="Resources\ButtonStyles.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- Treat App.xaml as a Page (not the auto-generated entry point) so the custom Main in
         App.xaml.cs can call VelopackApp.Build().Run() before the WPF app starts. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\ffmpeg\ffmpeg.exe" Condition="Exists('Resources\ffmpeg\ffmpeg.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\ffmpeg\README.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
