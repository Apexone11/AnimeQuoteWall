<Page x:Class="AnimeQuoteWall.GUI.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      Title="Settings">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/ButtonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
        <StackPanel>
            <!-- Theme Settings Card -->
            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"
                               Margin="0,0,0,18">
                        <InlineUIContainer>
                            <iconPacks:PackIconMaterial Kind="PaletteOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                        </InlineUIContainer>
                        <Run Text=" Appearance"/>
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Theme:"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextSecondary}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <ComboBox x:Name="ThemeModeComboBox"
                                  Width="200"
                                  Height="40"
                                  SelectionChanged="ThemeModeComboBox_SelectionChanged"
                                  Style="{StaticResource ModernComboBox}">
                            <ComboBoxItem Content="System Default"/>
                            <ComboBoxItem Content="Light"/>
                            <ComboBoxItem Content="Dark"/>
                        </ComboBox>
                    </StackPanel>

                    <TextBlock Text="Theme changes will apply after application restart"
                               FontSize="12"
                               Foreground="{DynamicResource TextTertiary}"
                               Margin="8,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Behavior Settings Card -->
            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"
                               Margin="0,0,0,18">
                        <InlineUIContainer>
                            <iconPacks:PackIconMaterial Kind="CogOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                        </InlineUIContainer>
                        <Run Text=" Behavior Settings"/>
                    </TextBlock>

                    <CheckBox x:Name="AutoRefreshPreviewCheckBox"
                              Content="Auto-refresh preview after generation"
                              Style="{StaticResource ModernCheckBox}"
                              Margin="0,0,0,12"
                              Checked="AutoRefreshPreviewCheckBox_Checked"
                              Unchecked="AutoRefreshPreviewCheckBox_Unchecked"/>

                    <CheckBox x:Name="ShowNotificationsCheckBox"
                              Content="Show notifications on generation"
                              Style="{StaticResource ModernCheckBox}"
                              Margin="0,0,0,12"
                              Checked="ShowNotificationsCheckBox_Checked"
                              Unchecked="ShowNotificationsCheckBox_Unchecked"/>

                    <CheckBox x:Name="AutoSaveHistoryCheckBox"
                              Content="Automatically save to history"
                              Style="{StaticResource ModernCheckBox}"
                              Margin="0,0,0,12"
                              Checked="AutoSaveHistoryCheckBox_Checked"
                              Unchecked="AutoSaveHistoryCheckBox_Unchecked"/>

                    <CheckBox x:Name="StartWithWindowsCheckBox"
                              Content="Start AnimeQuoteWall when Windows starts"
                              Style="{StaticResource ModernCheckBox}"
                              Margin="0,0,0,12"
                              Checked="StartWithWindowsCheckBox_Checked"
                              Unchecked="StartWithWindowsCheckBox_Unchecked"
                              ToolTip="Adds a per-user startup entry (no administrator rights required)."/>

                    <CheckBox x:Name="MinimizeToTrayCheckBox"
                              Content="Minimize to the system tray instead of the taskbar"
                              Style="{StaticResource ModernCheckBox}"
                              Margin="0,0,0,12"
                              Checked="MinimizeToTrayCheckBox_Checked"
                              Unchecked="MinimizeToTrayCheckBox_Unchecked"
                              ToolTip="When minimized, hide the window to the notification area; double-click the tray icon to restore."/>

                    <Separator Margin="0,8,0,12" Background="{DynamicResource BorderColor}"/>

                    <TextBlock Text="Advanced Features"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}"
                               Margin="0,0,0,8"/>

                    <CheckBox x:Name="EnableAnimatedApplyCheckBox"
                              Content="Enable animated wallpaper apply"
                              Style="{StaticResource ModernCheckBox}"
                              Margin="0,0,0,12"
                              Checked="EnableAnimatedApplyCheckBox_Checked"
                              Unchecked="EnableAnimatedApplyCheckBox_Unchecked"
                              ToolTip="Allow applying animated wallpapers via Wallpaper Engine integration."/>

                    <CheckBox x:Name="EnablePerMonitorApplyCheckBox"
                              Content="Enable per-monitor wallpaper apply"
                              Style="{StaticResource ModernCheckBox}"
                              Margin="0,0,0,0"
                              Checked="EnablePerMonitorApplyCheckBox_Checked"
                              Unchecked="EnablePerMonitorApplyCheckBox_Unchecked"
                              ToolTip="Allow applying different wallpapers to different monitors."/>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <TextBlock Text="Background fit:"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextSecondary}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <ComboBox x:Name="FillModeComboBox"
                                  Width="200"
                                  Height="40"
                                  SelectionChanged="FillModeComboBox_SelectionChanged"
                                  Style="{StaticResource ModernComboBox}"
                                  ToolTip="How background images are fit to the wallpaper: Fill (cover and crop), Fit (letterbox), Stretch (distort), or Center."
                                  AutomationProperties.Name="Background fit mode">
                            <ComboBoxItem Content="Fill (cover)" Tag="Fill"/>
                            <ComboBoxItem Content="Fit (letterbox)" Tag="Fit"/>
                            <ComboBoxItem Content="Stretch" Tag="Stretch"/>
                            <ComboBoxItem Content="Center" Tag="Center"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="Background effect:"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextSecondary}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <ComboBox x:Name="FilterEffectComboBox"
                                  Width="200"
                                  Height="40"
                                  SelectionChanged="FilterEffectComboBox_SelectionChanged"
                                  Style="{StaticResource ModernComboBox}"
                                  ToolTip="Artistic filter applied to the background before the quote is drawn."
                                  AutomationProperties.Name="Background effect">
                            <ComboBoxItem Content="None" Tag="None"/>
                            <ComboBoxItem Content="Blur" Tag="Blur"/>
                            <ComboBoxItem Content="Sepia" Tag="Sepia"/>
                            <ComboBoxItem Content="Grayscale" Tag="Grayscale"/>
                            <ComboBoxItem Content="Vintage" Tag="Vintage"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Performance and Power Settings Card -->
            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"
                               Margin="0,0,0,18">
                        <InlineUIContainer>
                            <iconPacks:PackIconMaterial Kind="SpeedometerSlow" Width="18" Height="18" VerticalAlignment="Center"/>
                        </InlineUIContainer>
                        <Run Text=" Performance and Power"/>
                    </TextBlock>

                    <CheckBox x:Name="LowPowerModeCheckBox"
                              Content="Low-Power mode (caps framerate, disables heavy effects, enables all pause rules)"
                              Style="{StaticResource ModernCheckBox}"
                              Margin="0,0,0,14"
                              Checked="LowPowerModeCheckBox_Checked"
                              Unchecked="LowPowerModeCheckBox_Unchecked"
                              ToolTip="Recommended for laptops and low-end machines."
                              AutomationProperties.Name="Enable Low-Power mode"/>

                    <TextBlock Text="Pause wallpaper rotation and animation when:"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}"
                               Margin="0,0,0,10"/>

                    <CheckBox x:Name="PauseOnFullscreenCheckBox"
                              Content="A fullscreen app is running (games, movies)"
                              Style="{StaticResource ModernCheckBox}"
                              Margin="0,0,0,10"
                              Checked="PauseOnFullscreenCheckBox_Checked"
                              Unchecked="PauseOnFullscreenCheckBox_Unchecked"/>
                    <CheckBox x:Name="PauseOnMaximizedCheckBox"
                              Content="A window covers most of the screen (maximized)"
                              Style="{StaticResource ModernCheckBox}"
                              Margin="0,0,0,10"
                              Checked="PauseOnMaximizedCheckBox_Checked"
                              Unchecked="PauseOnMaximizedCheckBox_Unchecked"/>
                    <CheckBox x:Name="PauseOnBatteryCheckBox"
                              Content="The device is on battery power"
                              Style="{StaticResource ModernCheckBox}"
                              Margin="0,0,0,10"
                              Checked="PauseOnBatteryCheckBox_Checked"
                              Unchecked="PauseOnBatteryCheckBox_Unchecked"/>
                    <CheckBox x:Name="PauseOnRemoteDesktopCheckBox"
                              Content="In a Remote Desktop session"
                              Style="{StaticResource ModernCheckBox}"
                              Margin="0,0,0,14"
                              Checked="PauseOnRemoteDesktopCheckBox_Checked"
                              Unchecked="PauseOnRemoteDesktopCheckBox_Unchecked"/>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock x:Name="CoverageThresholdLabel"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,0,0,4"/>
                        <Slider x:Name="CoverageThresholdSlider"
                                Minimum="50" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                Width="280" HorizontalAlignment="Left"
                                ValueChanged="CoverageThresholdSlider_ValueChanged"
                                AutomationProperties.Name="Maximized coverage threshold percent"/>
                    </StackPanel>

                    <TextBlock Text="Always pause for these apps (process names, comma-separated; .exe optional):"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondary}"
                               Margin="0,0,0,6"
                               TextWrapping="Wrap"/>
                    <TextBox x:Name="PerAppPauseTextBox"
                             Padding="10"
                             Margin="0,0,0,4"
                             Background="{DynamicResource HoverBackground}"
                             BorderBrush="{DynamicResource BorderColor}"
                             BorderThickness="1"
                             FontSize="13"
                             Foreground="{DynamicResource TextPrimary}"
                             LostKeyboardFocus="PerAppPauseTextBox_LostKeyboardFocus"
                             ToolTip="Example: chrome, photoshop, obs64"
                             AutomationProperties.Name="Per-application pause list"/>
                </StackPanel>
            </Border>

            <!-- Multi-Monitor Settings Card -->
            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"
                               Margin="0,0,0,18">
                        <InlineUIContainer>
                            <iconPacks:PackIconMaterial Kind="Monitor" Width="18" Height="18" VerticalAlignment="Center"/>
                        </InlineUIContainer>
                        <Run Text=" Multi-Monitor Settings"/>
                    </TextBlock>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Monitor Mode:"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,0,0,8"/>
                        <ComboBox x:Name="MonitorModeComboBox"
                                  Width="280"
                                  Height="40"
                                  SelectionChanged="MonitorModeComboBox_SelectionChanged"
                                  Style="{StaticResource ModernComboBox}">
                            <ComboBoxItem Content="Primary Monitor Only" Tag="Primary"/>
                            <ComboBoxItem Content="All Monitors (Same)" Tag="All"/>
                            <ComboBoxItem Content="Span All Monitors" Tag="Span"/>
                        </ComboBox>
                        <TextBlock Text="Select how wallpapers are applied across multiple monitors"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextTertiary}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Separator Margin="0,8,0,16" Background="{DynamicResource BorderColor}"/>

                    <StackPanel x:Name="MonitorSelectionPanel">
                        <TextBlock Text="Select Monitors:"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,0,0,10"/>
                        <StackPanel x:Name="MonitorCheckboxesPanel" Margin="0,0,0,8"/>
                        <Button x:Name="RefreshMonitorsButton"
                                MinWidth="180"
                                Height="36"
                                FontSize="12"
                                Click="RefreshMonitorsButton_Click"
                                Style="{StaticResource ModernSecondaryButton}"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Refresh Monitors" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="Monitors are automatically detected. Click refresh if you connected/disconnected a monitor."
                                   FontSize="11"
                                   Foreground="{DynamicResource TextTertiary}"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- File Paths Settings Card -->
            <Border Style="{StaticResource ModernCard}">
                <StackPanel>
                    <TextBlock FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"
                               Margin="0,0,0,20">
                        <InlineUIContainer>
                            <iconPacks:PackIconMaterial Kind="FolderOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                        </InlineUIContainer>
                        <Run Text=" File Locations"/>
                    </TextBlock>

                    <!-- Backgrounds Path -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Backgrounds Folder:"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="BackgroundsPathTextBox"
                                     Grid.Column="0"
                                     IsReadOnly="True"
                                     Padding="12"
                                     Margin="0,0,10,0"
                                     Background="{DynamicResource HoverBackground}"
                                     BorderBrush="{DynamicResource BorderColor}"
                                     BorderThickness="1"
                                     FontSize="13"
                                     Foreground="{DynamicResource TextPrimary}"/>
                            <Button x:Name="BrowseBackgroundsButton"
                                    Grid.Column="1"
                                    MinWidth="120"
                                    Height="38"
                                    FontSize="12"
                                    Click="BrowseBackgroundsButton_Click"
                                    Style="{StaticResource ModernSecondaryButton}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="FolderOutline" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Browse" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Quotes Path -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Quotes File:"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="QuotesPathTextBox"
                                     Grid.Column="0"
                                     IsReadOnly="True"
                                     Padding="12"
                                     Margin="0,0,10,0"
                                     Background="{DynamicResource HoverBackground}"
                                     BorderBrush="{DynamicResource BorderColor}"
                                     BorderThickness="1"
                                     FontSize="13"
                                     Foreground="{DynamicResource TextPrimary}"/>
                            <Button x:Name="BrowseQuotesButton"
                                    Grid.Column="1"
                                    MinWidth="120"
                                    Height="38"
                                    FontSize="12"
                                    Click="BrowseQuotesButton_Click"
                                    Style="{StaticResource ModernSecondaryButton}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="FileDocumentOutline" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Browse" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Output Path -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Output Wallpaper Path:"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OutputPathTextBox"
                                     Grid.Column="0"
                                     IsReadOnly="True"
                                     Padding="12"
                                     Margin="0,0,10,0"
                                     Background="{DynamicResource HoverBackground}"
                                     BorderBrush="{DynamicResource BorderColor}"
                                     BorderThickness="1"
                                     FontSize="13"
                                     Foreground="{DynamicResource TextPrimary}"/>
                            <Button x:Name="BrowseOutputButton"
                                    Grid.Column="1"
                                    MinWidth="120"
                                    Height="38"
                                    FontSize="12"
                                    Click="BrowseOutputButton_Click"
                                    Style="{StaticResource ModernSecondaryButton}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="ContentSaveOutline" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Browse" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <Button x:Name="ResetDefaultsButton"
                            MinWidth="200"
                            Height="40"
                            FontSize="13"
                            Click="ResetDefaultsButton_Click"
                            Style="{StaticResource ModernSecondaryButton}"
                            HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Reset to Defaults" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Restart Warning Banner - shown only when paths have changed -->
                    <Border x:Name="RestartWarningBanner"
                            Background="{DynamicResource WarningDark}"
                            BorderBrush="{DynamicResource WarningColor}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,10"
                            Margin="0,16,0,0"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="AlertCircleOutline" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="White"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Path changed - restart required"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           Margin="0,0,0,2"/>
                                <TextBlock Text="The new path will take effect the next time you restart the application."
                                           FontSize="12"
                                           Foreground="White"
                                           Opacity="0.9"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!-- Path validation error banner -->
                    <Border x:Name="PathValidationErrorBanner"
                            Background="{DynamicResource DangerDark}"
                            BorderBrush="{DynamicResource DangerColor}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,10"
                            Margin="0,8,0,0"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="CloseCircleOutline" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="White"/>
                            <TextBlock x:Name="PathValidationErrorText"
                                       FontSize="12"
                                       Foreground="White"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Shortcuts Card -->
            <Border Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="Shortcuts"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"
                               Margin="0,0,0,12"/>
                    <WrapPanel>
                        <Button Style="{StaticResource ModernSecondaryButton}"
                                Content="Open data folder"
                                Margin="0,0,8,8"
                                Click="OpenDataFolderButton_Click"
                                AutomationProperties.Name="Open user data folder in Explorer"/>
                        <Button Style="{StaticResource ModernSecondaryButton}"
                                Content="Open log folder"
                                Margin="0,0,8,8"
                                Click="OpenLogFolderButton_Click"
                                AutomationProperties.Name="Open log folder in Explorer"/>
                        <Button Style="{StaticResource ModernSecondaryButton}"
                                Content="Export backup"
                                Margin="0,0,8,8"
                                Click="ExportBackupButton_Click"
                                AutomationProperties.Name="Export settings, quotes, and backgrounds to a ZIP archive"/>
                        <Button Style="{StaticResource ModernSecondaryButton}"
                                Content="Import backup"
                                Margin="0,0,8,8"
                                Click="ImportBackupButton_Click"
                                AutomationProperties.Name="Restore settings, quotes, and backgrounds from a ZIP archive"/>
                        <Button Style="{StaticResource ModernSecondaryButton}"
                                Content="About"
                                Margin="0,0,8,8"
                                Click="AboutButton_Click"
                                AutomationProperties.Name="Show the About dialog"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Information Card -->
            <Border Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"
                               Margin="0,0,0,12">
                        <InlineUIContainer>
                            <iconPacks:PackIconMaterial Kind="InformationOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                        </InlineUIContainer>
                        <Run Text=" Default Locations"/>
                    </TextBlock>
                    <TextBlock x:Name="DefaultPathsInfo"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap"
                               LineHeight="20"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>


