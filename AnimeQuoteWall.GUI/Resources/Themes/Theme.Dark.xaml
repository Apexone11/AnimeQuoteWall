<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark Theme Brushes -->
    <SolidColorBrush x:Key="WindowBackground"  Color="#0D0F14"/>
    <SolidColorBrush x:Key="CardBackground"    Color="#161A23"/>
    <SolidColorBrush x:Key="PrimaryColor"      Color="#818CF8"/>
    <SolidColorBrush x:Key="PrimaryDark"       Color="#6366F1"/>
    <SolidColorBrush x:Key="PrimaryLight"      Color="#A5B4FC"/>
    <SolidColorBrush x:Key="SuccessColor"      Color="#34D399"/>
    <SolidColorBrush x:Key="SuccessDark"       Color="#10B981"/>
    <SolidColorBrush x:Key="DangerColor"       Color="#F87171"/>
    <SolidColorBrush x:Key="DangerDark"        Color="#EF4444"/>
    <SolidColorBrush x:Key="WarningColor"      Color="#FBBF24"/>
    <SolidColorBrush x:Key="WarningDark"       Color="#F59E0B"/>
    <SolidColorBrush x:Key="SecondaryColor"    Color="#9CA3AF"/>
    <SolidColorBrush x:Key="TextPrimary"       Color="#F9FAFB"/>
    <SolidColorBrush x:Key="TextSecondary"     Color="#9CA3AF"/>
    <SolidColorBrush x:Key="TextTertiary"      Color="#6B7280"/>
    <SolidColorBrush x:Key="BorderColor"       Color="#252C3B"/>
    <SolidColorBrush x:Key="HoverBackground"   Color="#1E2333"/>
    <SolidColorBrush x:Key="SidebarBackground"  Color="#0D1117"/>
    <SolidColorBrush x:Key="SidebarBorder"      Color="#161B22"/>
    <SolidColorBrush x:Key="SidebarText"        Color="#94A3B8"/>
    <SolidColorBrush x:Key="SidebarTextMuted"   Color="#6B7280"/>
    <SolidColorBrush x:Key="SidebarSectionLabel" Color="#374151"/>
    <SolidColorBrush x:Key="SidebarHover"       Color="#1E2333"/>
    <SolidColorBrush x:Key="SidebarItemHover"   Color="#161B22"/>
    <SolidColorBrush x:Key="SidebarText_Selected" Color="#F9FAFB"/>
    <SolidColorBrush x:Key="SidebarText_Hover"  Color="#C7D2FE"/>
    <SolidColorBrush x:Key="SidebarBrandHeading" Color="#F9FAFB"/>
    <SolidColorBrush x:Key="SidebarAccent"      Color="#818CF8"/>
    <SolidColorBrush x:Key="DisabledForeground" Color="#4B5563"/>
    <SolidColorBrush x:Key="DisabledBackground" Color="#1F2937"/>
    <SolidColorBrush x:Key="ScrimBackground"    Color="#80000000"/>

    <!-- Effect / overlay tokens. Theme-aware so DropShadowEffect.Color and media
         overlays follow light/dark switching. Color resources (not brushes) are used
         where the consumer property is of type Color (e.g. DropShadowEffect.Color). -->
    <Color x:Key="ShadowColor">#000000</Color>
    <Color x:Key="AccentGlowColor">#818CF8</Color>
    <Color x:Key="ScrimColor">#80000000</Color>
    <SolidColorBrush x:Key="ScrimBackgroundSoft" Color="#66000000"/>
    <SolidColorBrush x:Key="PrimaryOverlayBrush" Color="#CC818CF8"/>

    <!-- Brand button gradient ramps. These are intentionally identical in light and
         dark themes so the primary/success/danger/warning buttons stay vibrant and
         consistent. Color resources are used because GradientStop.Color and
         DropShadowEffect.Color are of type Color. -->
    <!-- Primary (indigo) -->
    <Color x:Key="PrimaryButtonGradientTop">#818CF8</Color>
    <Color x:Key="PrimaryButtonGradientBottom">#6366F1</Color>
    <Color x:Key="PrimaryButtonGlow">#6366F1</Color>
    <Color x:Key="PrimaryButtonHoverTop">#9CA3F9</Color>
    <Color x:Key="PrimaryButtonHoverBottom">#7C7DF3</Color>
    <Color x:Key="PrimaryButtonHoverGlow">#818CF8</Color>
    <Color x:Key="PrimaryButtonPressedTop">#6B73F0</Color>
    <Color x:Key="PrimaryButtonPressedBottom">#4F46E5</Color>
    <!-- Success (green) -->
    <Color x:Key="SuccessButtonGradientTop">#34D399</Color>
    <Color x:Key="SuccessButtonGradientBottom">#10B981</Color>
    <Color x:Key="SuccessButtonGlow">#10B981</Color>
    <Color x:Key="SuccessButtonHoverTop">#4ADE80</Color>
    <Color x:Key="SuccessButtonHoverBottom">#22C55E</Color>
    <Color x:Key="SuccessButtonHoverGlow">#22C55E</Color>
    <Color x:Key="SuccessButtonPressedTop">#22C55E</Color>
    <Color x:Key="SuccessButtonPressedBottom">#059669</Color>
    <!-- Danger (red) -->
    <Color x:Key="DangerButtonGradientTop">#F87171</Color>
    <Color x:Key="DangerButtonGradientBottom">#EF4444</Color>
    <Color x:Key="DangerButtonGlow">#EF4444</Color>
    <Color x:Key="DangerButtonHoverTop">#FB7185</Color>
    <Color x:Key="DangerButtonHoverBottom">#F43F5E</Color>
    <Color x:Key="DangerButtonHoverGlow">#F43F5E</Color>
    <Color x:Key="DangerButtonPressedTop">#F43F5E</Color>
    <Color x:Key="DangerButtonPressedBottom">#DC2626</Color>
    <!-- Warning (amber) -->
    <Color x:Key="WarningButtonGradientTop">#FBBF24</Color>
    <Color x:Key="WarningButtonGradientBottom">#F59E0B</Color>
    <Color x:Key="WarningButtonGlow">#F59E0B</Color>
    <Color x:Key="WarningButtonHoverTop">#FCD34D</Color>
    <Color x:Key="WarningButtonHoverBottom">#FBBF24</Color>
    <Color x:Key="WarningButtonHoverGlow">#FBBF24</Color>
    <!-- Warning button uses dark text on the amber fill for contrast. Brush type. -->
    <SolidColorBrush x:Key="WarningButtonForeground" Color="#1C1917"/>
    <!-- Toggle-on border accent (green). Brush type (BorderBrush). -->
    <SolidColorBrush x:Key="ToggleCheckedBorderBrush" Color="#22C55E"/>
</ResourceDictionary>
